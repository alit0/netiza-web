---
import Button from '../ui/Button.astro';

// Bridge from the home to /diagnostico. Sits right after ElProblema, where the
// visitor has just recognised the problem. Deliberately small: the home is
// already tight on mobile height, so this is a title, one line and a button —
// no cards, no illustration.
---

<section class="puente" aria-labelledby="puente-title">
  <div class="puente__inner">
    <h2 id="puente-title" class="puente__title">¿Querés ver cómo estás hoy?</h2>
    <p class="puente__body">
      Doce preguntas, dos minutos. Te mostramos qué funciona y qué no en tu negocio.
    </p>
    <Button href="/diagnostico">Hacer el diagnóstico</Button>
  </div>
</section>

<style>
  .puente {
    /* No vertical padding on purpose: the neighbouring sections already pad
       generously, and stacking a third gap wastes ~200px of mobile height. */
    padding-block: 0;
  }

  .puente__inner {
    max-width: 560px;
    margin: 0 auto;
    padding: var(--space-10) var(--space-8);
    text-align: center;
    background: var(--card-bg);
    border-radius: var(--card-radius);
  }

  .puente__title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
  }

  .puente__body {
    font-size: var(--font-size-base);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 auto var(--space-6);
    max-width: 42ch;
  }

  @media (max-width: 809px) {
    .puente {
      padding-inline: var(--space-6);
    }

    .puente__inner {
      padding: var(--space-8) var(--space-6);
    }

    .puente__title {
      font-size: var(--font-size-xl);
      letter-spacing: -0.04em;
    }
  }
</style>
