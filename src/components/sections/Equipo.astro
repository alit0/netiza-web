---
import Kicker from '../ui/Kicker.astro';

const members = [
  { photo: 'foto-emi', name: 'Emilia', role: 'Estrategia y UX', alt: 'Retrato de Emilia, estrategia y UX en Netiza' },
  { photo: 'foto-pame', name: 'Pamela', role: 'Negocio y e-commerce', alt: 'Retrato de Pamela, negocio y e-commerce en Netiza' },
  { photo: 'foto-ale', name: 'Alejandro', role: 'Tecnología e IA', alt: 'Retrato de Alejandro, tecnología e IA en Netiza' },
];
---

<section class="equipo section" aria-labelledby="equipo-title">
  <div class="equipo__inner">
    <Kicker>Equipo</Kicker>
    <h2 id="equipo-title" class="equipo__title">
      Personas <span class="accent">reales</span> detrás de tu proyecto.
    </h2>
    <div class="m-slider">
      {members.map((member) => (
        <figure class="equipo__member">
          <div class="equipo__photo">
            <img
              src={`/assets/${member.photo}.webp`}
              alt={member.alt}
              width="341"
              height="420"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>
            <p class="equipo__name">{member.name}</p>
            <p class="equipo__role">{member.role}</p>
          </figcaption>
        </figure>
      ))}
    </div>
    {/* Position dots — only shown on mobile, where the grid becomes a slider. */}
    <div class="m-slider__dots" role="group" aria-label="Navegar entre el equipo">
      {members.map((member, i) => (
        <button
          class="m-slider__dot"
          type="button"
          aria-label={`Ver a ${member.name}`}
          aria-current={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  .equipo {
    padding-block: var(--space-section-y);
  }

  .equipo__inner {
    max-width: 1072px;
    margin: 0 auto;
  }

  .equipo__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-medium);
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: var(--space-6) 0 var(--space-12);
  }

  .equipo__member {
    margin: 0;
  }

  .equipo__photo {
    overflow: hidden;
    border-radius: var(--radius-md);
    aspect-ratio: 341 / 420;
    background: var(--media-bg);
    margin-bottom: var(--space-4);
  }

  .equipo__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .equipo__name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1);
    letter-spacing: -0.05em;
  }

  .equipo__role {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 809px) {
    .equipo__inner {
      padding-inline: var(--space-6);
    }

    .equipo__title {
      font-size: var(--font-size-xl);
      line-height: 1.12;
      letter-spacing: -0.05em;
    }

    .equipo__name {
      font-size: var(--font-size-lg);
      letter-spacing: -0.04em;
    }
  }
</style>

<script>
  import { initMobileSlider } from '../../scripts/mobileSlider';

  const section = document.querySelector<HTMLElement>('.equipo');
  if (section) initMobileSlider(section);
</script>
