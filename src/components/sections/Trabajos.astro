---
import Kicker from '../ui/Kicker.astro';
import MediaSlot from '../ui/MediaSlot.astro';

const reels = [
  { src: 'producto', label: 'Reel — producto local' },
  { src: 'turismo-rural', label: 'Reel — turismo rural' },
  { src: 'detras-escena', label: 'Reel — detrás de escena' },
];
---

<section class="trabajos section" aria-labelledby="trabajos-title">
  <div class="trabajos__inner">
    <Kicker>Trabajos</Kicker>
    <h2 id="trabajos-title" class="trabajos__title">
      Contenido que <span class="accent">trabaja</span> por tu negocio.
    </h2>
    <div class="m-slider">
      {reels.map((reel) => (
        <figure class="trabajos__reel">
          <MediaSlot label={reel.label}>
            <video
              class="trabajos__video"
              src={`/assets/${reel.src}.mp4`}
              poster={`/assets/${reel.src}-poster.webp`}
              width="336"
              height="480"
              muted
              playsinline
              loop
              preload="none"
              aria-hidden="true"
            ></video>
          </MediaSlot>
          <figcaption class="trabajos__label">{reel.label}</figcaption>
        </figure>
      ))}
    </div>
    {/* Position dots — only shown on mobile, where the grid becomes a slider. */}
    <div class="m-slider__dots" role="group" aria-label="Navegar entre los trabajos">
      {reels.map((reel, i) => (
        <button
          class="m-slider__dot"
          type="button"
          aria-label={`Ver ${reel.label}`}
          aria-current={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  .trabajos {
    padding-block: var(--space-section-y);
  }

  .trabajos__inner {
    max-width: 1072px;
    margin: 0 auto;
  }

  .trabajos__title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-display-weight);
    line-height: 1.12;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: var(--space-6) 0 var(--space-12);
  }

  .trabajos__reel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .trabajos__reel :global(.media-slot) {
    position: relative;
    border-radius: var(--media-radius);
  }

  .trabajos__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .trabajos__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-align: center;
  }

  @media (max-width: 809px) {
    .trabajos__inner {
      padding-inline: var(--space-6);
    }

    .trabajos__title {
      font-size: var(--font-size-xl);
      line-height: 1.12;
      letter-spacing: -0.05em;
    }
  }
</style>

<script>
  import { initMobileSlider } from '../../scripts/mobileSlider';

  const section = document.querySelector<HTMLElement>('.trabajos');

  if (section) {
    const videos = Array.from(section.querySelectorAll<HTMLVideoElement>('.trabajos__video'));
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mqMobile = window.matchMedia('(max-width: 809px)');

    // Mobile: only the centered reel plays (others show poster) to save data.
    initMobileSlider(section, {
      onActiveChange: (index) => {
        if (!mqMobile.matches) return;
        videos.forEach((video, i) => {
          if (i === index) {
            if (!prefersReducedMotion) video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
    });

    // Desktop: every reel plays while the section is in view.
    const desktopObserver = new IntersectionObserver(
      (entries) => {
        if (mqMobile.matches) return;
        entries.forEach((entry) => {
          const video = (entry.target as HTMLElement).querySelector<HTMLVideoElement>('.trabajos__video');
          if (!video) return;
          if (entry.isIntersecting) {
            if (!prefersReducedMotion) video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25, rootMargin: '0px 0px 15% 0px' }
    );
    section.querySelectorAll('.trabajos__reel').forEach((reel) => desktopObserver.observe(reel));
  }
</script>
