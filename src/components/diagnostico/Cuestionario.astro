---
import Kicker from '../ui/Kicker.astro';

// Los datos del cuestionario los importa el <script> de abajo, no este
// frontmatter: pasarlos con `define:vars` obliga a Astro a servir el script
// como `is:inline`, y un script inline NO se transpila. Cualquier sintaxis de
// TypeScript viajaria cruda al navegador y romperia el parseo entero, sin que
// `npm run build` se entere. Ver scripts/smoke-diagnostico.py.
---

<section id="cuestionario" class="cuestionario section" aria-labelledby="cuestionario-titulo">
  <div class="cuestionario__grid">
    <!-- Persistent context: stays put while the panel on the right advances. -->
    <aside class="cuestionario__contexto">
      <Kicker>Diagnóstico</Kicker>
      <h2 id="cuestionario-titulo" class="cuestionario__titulo">
        Cómo te ve alguien que te busca <span class="accent">hoy</span>.
      </h2>
      <p class="cuestionario__bajada">
        12 preguntas, 3 minutos. Al final ves en qué estás parado y qué conviene tocar primero.
      </p>

      <ol class="cuestionario__bloques" id="cuestionario-bloques">
        <li class="cuestionario__bloque" data-dimension="encuentran">
          <span class="cuestionario__bloque-marca" aria-hidden="true"></span>
          <span class="cuestionario__bloque-nombre">Te encuentran</span>
          <span class="cuestionario__bloque-conteo" data-conteo>0/3</span>
        </li>
        <li class="cuestionario__bloque" data-dimension="entienden">
          <span class="cuestionario__bloque-marca" aria-hidden="true"></span>
          <span class="cuestionario__bloque-nombre">Te entienden</span>
          <span class="cuestionario__bloque-conteo" data-conteo>0/3</span>
        </li>
        <li class="cuestionario__bloque" data-dimension="escriben">
          <span class="cuestionario__bloque-marca" aria-hidden="true"></span>
          <span class="cuestionario__bloque-nombre">Te escriben</span>
          <span class="cuestionario__bloque-conteo" data-conteo>0/3</span>
        </li>
        <li class="cuestionario__bloque" data-dimension="eligen">
          <span class="cuestionario__bloque-marca" aria-hidden="true"></span>
          <span class="cuestionario__bloque-nombre">Te siguen eligiendo</span>
          <span class="cuestionario__bloque-conteo" data-conteo>0/3</span>
        </li>
      </ol>
    </aside>

    <div class="cuestionario__panel">
      <div class="cuestionario__meta">
        <span class="cuestionario__contador" aria-live="polite" id="cuestionario-contador">Pregunta 1 de 12</span>
        <span class="cuestionario__dimension" aria-live="polite" id="cuestionario-dimension">¿Te encuentran?</span>
      </div>

      <div
        class="cuestionario__barra"
        role="progressbar"
        id="cuestionario-barra"
        aria-valuenow="1"
        aria-valuemin="1"
        aria-valuemax="12"
        aria-label="Progreso del diagnóstico"
      >
        <div class="cuestionario__barra-fill" id="cuestionario-barra-fill" style="width: 8.3%"></div>
      </div>

      <div class="cuestionario__pantalla" id="cuestionario-pantalla" tabindex="-1" role="region" aria-live="polite" aria-label="Pregunta actual">
      </div>

      <div class="cuestionario__nav">
        <button class="cuestionario__nav-btn cuestionario__nav-btn--prev" id="cuestionario-prev" type="button" disabled>
          Anterior
        </button>
        <span class="cuestionario__paso" id="cuestionario-paso" aria-hidden="true"></span>
        <span class="cuestionario__nota">Se guarda solo. Podés volver atrás.</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Layout mirrors the Penpot board: 400 + 608 with a 64px gutter inside the
     1072 container, both columns top-aligned. Mobile collapses to one column
     and drops the context panel, which is orientation, not content. */
  .cuestionario {
    padding-block: var(--space-section-y);
  }

  .cuestionario__grid {
    display: grid;
    grid-template-columns: 400px 608px;
    gap: var(--space-16);
    justify-content: center;
    align-items: start;
  }

  .cuestionario__contexto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .cuestionario__titulo {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-display-weight);
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: 0;
  }

  .cuestionario__bajada {
    font-size: var(--font-size-md);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Block tracker: the anchor while the panel advances. */
  .cuestionario__bloques {
    list-style: none;
    width: 100%;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cuestionario__bloque {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: var(--space-3) var(--space-4) var(--space-3) 14px;
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-text-primary) 45%, transparent);
  }

  .cuestionario__bloque[data-activo] {
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .cuestionario__bloque-marca {
    width: 3px;
    height: 18px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-text-primary) 15%, transparent);
  }

  .cuestionario__bloque[data-activo] .cuestionario__bloque-marca {
    background: var(--color-accent);
  }

  .cuestionario__bloque-nombre {
    flex: 1;
  }

  .cuestionario__bloque-conteo {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: color-mix(in srgb, var(--color-text-primary) 30%, transparent);
  }

  .cuestionario__bloque[data-activo] .cuestionario__bloque-conteo {
    color: color-mix(in srgb, var(--color-text-primary) 60%, transparent);
  }

  /* The panel is the only surface on this screen besides the options. */
  .cuestionario__panel {
    background: var(--card-bg);
    border-radius: var(--card-radius);
    padding: var(--space-8);
  }

  .cuestionario__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .cuestionario__contador {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-text-primary) 60%, transparent);
  }

  .cuestionario__dimension {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    color: var(--color-state-danger-text);
  }

  .cuestionario__barra {
    width: 100%;
    height: 6px;
    margin-top: 14px;
    background: var(--meter-track-bg);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .cuestionario__barra-fill {
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  .cuestionario__pantalla {
    min-height: 12rem;
    margin-top: var(--space-7);
  }

  :global(.cuestionario__pregunta) {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: 0;
  }

  :global(.cuestionario__ayuda) {
    font-size: var(--font-size-sm);
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: var(--space-3) 0 0;
  }

  :global(.cuestionario__opciones) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    padding: 0;
    border: 0;
  }

  /* Tarjeta sin borde ni sombra y con el radio de tarjeta del sitio: las
     cards de QueHacemos y ParaQuien son superficie plana sobre el papel, no
     cajas delineadas. El borde que tenian estas opciones las delataba como
     ajenas al sistema. La seleccion se comunica con el indicador y un tinte
     de acento, nunca solo con color. */
  :global(.cuestionario__opcion) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    padding: var(--option-padding-block) var(--option-padding-inline);
    /* Raised, not surface: --card-bg sits a hair away from the canvas and the
       options read as ghosts. They have to look tappable. */
    background: var(--option-bg);
    border: 0;
    border-radius: var(--option-radius);
    cursor: pointer;
    font: inherit;
    font-size: var(--font-size-base);
    line-height: 1.45;
    color: var(--color-text-primary);
    text-align: left;
    min-height: var(--size-touch);
    transition:
      background-color var(--motion-control) ease,
      transform var(--motion-control) ease;
  }

  :global(.cuestionario__opcion:hover) {
    background: color-mix(in srgb, var(--color-accent) 5%, var(--option-bg));
  }

  /* Empuje fisico al tocar (skill 4.5): confirma el tap antes de que avance. */
  :global(.cuestionario__opcion:active) {
    transform: scale(0.99);
  }

  :global(.cuestionario__opcion:focus-visible) {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--space-1);
  }

  /* Chosen answer reads as "done", not as a score. Same green in both themes,
     so the answered state never shifts meaning between light and dark. */
  :global(.cuestionario__opcion--seleccionada) {
    background: var(--option-bg-selected);
    color: var(--option-text-selected);
    font-weight: var(--font-weight-medium);
  }

  :global(.cuestionario__opcion-indicador) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--radio-size);
    height: var(--radio-size);
    flex-shrink: 0;
    border-radius: var(--radius-full);
    border: 1.5px solid var(--color-text-primary);
    transition:
      border-color var(--motion-control) ease,
      background-color var(--motion-control) ease;
  }

  /* A 6px ring reads as a filled dot with a hairline of green around it. */
  :global(.cuestionario__opcion--seleccionada .cuestionario__opcion-indicador) {
    border: 6px solid var(--option-radio-selected);
    background: var(--option-radio-selected);
  }

  :global(.cuestionario__opcion-texto) {
    flex: 1;
  }

  .cuestionario__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .cuestionario__nota {
    font-size: var(--font-size-xs);
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-text-primary) 45%, transparent);
  }

  .cuestionario__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--size-touch);
    padding: var(--space-3) var(--space-5);
    border: var(--border-width) solid var(--color-border-subtle);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text-primary);
    font: var(--font-control-weight) var(--font-size-sm) / 1 var(--font-body);
    cursor: pointer;
    transition:
      border-color var(--motion-control) ease,
      opacity var(--motion-control) ease;
  }

  .cuestionario__nav-btn:hover:not(:disabled) {
    border-color: color-mix(in srgb, var(--color-text-primary) 24%, transparent);
  }

  .cuestionario__nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .cuestionario__nav-btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--space-1);
  }

  /* The step count lives in the panel header now. Keeping it here too put
     "1 de 12" on screen twice. Hidden, not deleted: the script still writes to
     it and it stays available to assistive tech. */
  .cuestionario__paso {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cuestionario__completado {
    text-align: center;
    padding-block: var(--space-12);
  }

  .cuestionario__completado-texto {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Below the two-column breakpoint the context panel is dropped: it is
     orientation, not content, and the counter above the question already says
     where you are. The panel loses its surface so the options are the only
     boxes left on screen. */
  @media (max-width: 1119px) {
    .cuestionario__grid {
      grid-template-columns: minmax(0, 620px);
      gap: var(--space-8);
    }

    .cuestionario__bajada,
    .cuestionario__bloques {
      display: none;
    }

    .cuestionario__panel {
      background: transparent;
      padding: 0;
    }

    .cuestionario__meta {
      margin-top: var(--space-6);
    }
  }

  @media (max-width: 809px) {
    .cuestionario__grid {
      padding-inline: var(--space-6);
    }

    .cuestionario__titulo {
      font-size: var(--font-size-2xl);
      line-height: 1.1;
    }

    :global(.cuestionario__pregunta) {
      font-size: var(--font-size-lg);
      line-height: 1.35;
      letter-spacing: normal;
    }

    .cuestionario__contador,
    .cuestionario__dimension {
      font-size: var(--font-size-xs);
    }

    :global(.cuestionario__opciones) {
      gap: 10px;
    }

    .cuestionario__pantalla {
      min-height: 10rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cuestionario__barra-fill {
      transition: none;
    }
  }
</style>

<script>
  import { preguntas, TOTAL_PREGUNTAS } from '../../data/diagnostico';

  const DIMENSIONES: Record<string, string> = {
    encuentran: '¿Te encuentran?',
    entienden: '¿Te entienden?',
    escriben: '¿Te escriben?',
    eligen: '¿Te siguen eligiendo?',
  };

  const pantalla = document.getElementById('cuestionario-pantalla')!;
  const contador = document.getElementById('cuestionario-contador')!;
  const dimension = document.getElementById('cuestionario-dimension')!;
  const barra = document.getElementById('cuestionario-barra') as HTMLElement;
  const barraFill = document.getElementById('cuestionario-barra-fill')!;
  const prevBtn = document.getElementById('cuestionario-prev') as HTMLButtonElement;
  const paso = document.getElementById('cuestionario-paso')!;
  const bloques = Array.from(
    document.querySelectorAll<HTMLElement>('#cuestionario-bloques .cuestionario__bloque')
  );

  let currentIndex = 0;
  const respuestas: (number | null)[] = new Array(TOTAL_PREGUNTAS).fill(null);
  let transitionLock = false;
  let startFired = false;
  let yaNavego = false;

  /**
   * Funnel hitos: detail (if any) goes on window for Resultado.
   * Mirror name-only on document so Analytics.astro document listeners fire
   * (window-targeted events do not reach document listeners).
   */
  function emitNetiza(name: string, detail?: unknown) {
    if (detail !== undefined) {
      window.dispatchEvent(new CustomEvent(name, { detail }));
    } else {
      window.dispatchEvent(new CustomEvent(name));
    }
    document.dispatchEvent(new CustomEvent(name));
  }

  function actualizarProgreso() {
    const n = currentIndex + 1;
    const dimActual = preguntas[currentIndex].dimension;
    contador.textContent = `Pregunta ${n} de ${TOTAL_PREGUNTAS}`;
    dimension.textContent = DIMENSIONES[dimActual] ?? '';
    barra.setAttribute('aria-valuenow', String(n));
    const pct = ((n / TOTAL_PREGUNTAS) * 100).toFixed(1);
    barraFill.style.width = `${pct}%`;
    actualizarBloques(dimActual);
  }

  /** Highlights the current block and counts answers within each one. */
  function actualizarBloques(dimActual: string) {
    bloques.forEach((li) => {
      const dim = li.getAttribute('data-dimension');
      if (!dim) return;

      if (dim === dimActual) {
        li.setAttribute('data-activo', '');
      } else {
        li.removeAttribute('data-activo');
      }

      const indices = preguntas
        .map((p: { dimension: string }, i: number) => (p.dimension === dim ? i : -1))
        .filter((i: number) => i >= 0);
      const respondidas = indices.filter((i: number) => respuestas[i] !== null).length;

      const conteo = li.querySelector('[data-conteo]');
      if (conteo) conteo.textContent = `${respondidas}/${indices.length}`;
    });
  }

  function render() {
    if (currentIndex >= TOTAL_PREGUNTAS) {
      completar();
      return;
    }

    const pregunta = preguntas[currentIndex];
    const seleccionada = respuestas[currentIndex];

    let html = `<p class="cuestionario__pregunta">${pregunta.texto}</p>`;

    if (pregunta.ayuda) {
      html += `<p class="cuestionario__ayuda">${pregunta.ayuda}</p>`;
    }

    html += '<fieldset class="cuestionario__opciones">';
    html += '<legend class="sr-only" style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;border:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap">Seleccioná una opción</legend>';

    pregunta.opciones.forEach((opcion: { texto: string; puntos: number }, i: number) => {
      const esSeleccionada = seleccionada === i;
      html += `
        <button
          class="cuestionario__opcion${esSeleccionada ? ' cuestionario__opcion--seleccionada' : ''}"
          type="button"
          role="radio"
          aria-checked="${esSeleccionada}"
          data-indice="${i}"
        >
          <span class="cuestionario__opcion-indicador" aria-hidden="true"></span>
          <span class="cuestionario__opcion-texto">${opcion.texto}</span>
        </button>`;
    });

    html += '</fieldset>';
    pantalla.innerHTML = html;

    prevBtn.disabled = currentIndex === 0;
    paso.textContent = `${currentIndex + 1} de ${TOTAL_PREGUNTAS}`;
    actualizarProgreso();

    pantalla.querySelectorAll('.cuestionario__opcion').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (transitionLock) return;
        const indice = Number((btn as HTMLElement).dataset.indice);
        seleccionar(indice);
      });
    });

    if (seleccionada !== null) {
      // Volviendo atras: el foco va a lo que ya habia elegido.
      const selectedBtn = pantalla.querySelector(`[data-indice="${seleccionada}"]`) as HTMLElement | null;
      selectedBtn?.focus();
    } else if (yaNavego) {
      // Pregunta nueva: el foco va a la region, NO a la primera opcion. Enfocar
      // la primera la pinta con el anillo de foco y se lee como ya elegida.
      // La region anuncia la pregunta igual y el teclado sigue entrando en orden.
      pantalla.focus();
    }
  }

  function seleccionar(opcionIndex: number) {
    if (transitionLock) return;
    respuestas[currentIndex] = opcionIndex;

    // First confirmed answer — not page open (analytics contract).
    if (!startFired) {
      startFired = true;
      emitNetiza('netiza:diagnostico_start');
    }

    pantalla.querySelectorAll('.cuestionario__opcion').forEach((btn) => {
      const el = btn as HTMLElement;
      const indice = Number(el.dataset.indice);
      const esSeleccionada = indice === opcionIndex;
      el.classList.toggle('cuestionario__opcion--seleccionada', esSeleccionada);
      el.setAttribute('aria-checked', String(esSeleccionada));
    });

    if (currentIndex < TOTAL_PREGUNTAS - 1) {
      transitionLock = true;
      setTimeout(() => {
        currentIndex++;
      yaNavego = true;
        transitionLock = false;
        render();
      }, 350);
    } else {
      completar();
    }
  }

  function completar() {
    // Build by screen index, then emit in strict P1..P12 order with literal option text.
    const byId = new Map<
      string,
      { id: string; dimension: string; puntos: number; texto: string }
    >();
    preguntas.forEach(
      (
        p: {
          id: string;
          dimension: string;
          opciones: { puntos: number; texto: string }[];
        },
        i: number,
      ) => {
        const optIndex = respuestas[i];
        if (optIndex === null) return;
        const opt = p.opciones[optIndex];
        byId.set(p.id.toUpperCase(), {
          id: p.id.toLowerCase(),
          dimension: p.dimension,
          puntos: opt.puntos,
          texto: opt.texto,
        });
      },
    );

    const respuestasOrdenadas = [];
    for (let n = 1; n <= 12; n++) {
      const item = byId.get(`P${n}`);
      if (!item) {
        console.error(`[diagnostico] missing answer for P${n}`);
        return;
      }
      respuestasOrdenadas.push(item);
    }

    pantalla.innerHTML = `
      <div class="cuestionario__completado" role="status">
        <p class="cuestionario__completado-texto">Calculando tu diagnóstico…</p>
      </div>`;

    contador.textContent = `${TOTAL_PREGUNTAS} de ${TOTAL_PREGUNTAS}`;
    barra.setAttribute('aria-valuenow', String(TOTAL_PREGUNTAS));
    barraFill.style.width = '100%';
    prevBtn.disabled = true;
    paso.textContent = '';
    dimension.textContent = '';

    // Canonical runtime contract (window + detail with literal texto). No direct gtag.
    emitNetiza('netiza:diagnostico_complete', { respuestas: respuestasOrdenadas });
  }

  prevBtn.addEventListener('click', () => {
    if (currentIndex > 0 && !transitionLock) {
      currentIndex--;
      render();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft' && currentIndex > 0 && !transitionLock) {
      e.preventDefault();
      currentIndex--;
      render();
    }
  });

  render();
</script>
